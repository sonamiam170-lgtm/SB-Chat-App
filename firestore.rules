rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function participant(chatId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if self(userId);
      allow update: if self(userId);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if participant(conversationId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if participant(conversationId);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if participant(conversationId);
        allow create: if participant(conversationId) && request.resource.data.senderId == request.auth.uid;
        allow update: if participant(conversationId);
        allow delete: if participant(conversationId);
      }
    }

    match /calls/{callId} {
      allow create: if signedIn() && (request.resource.data.callerId == request.auth.uid || request.resource.data.calleeId == request.auth.uid);
      allow read, update: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow delete: if false;
      match /candidates/{candidateId} {
        allow read, create: if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }

    match /incomingCalls/{userId}/items/{callId} {
      allow read, write: if self(userId);
    }

    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
